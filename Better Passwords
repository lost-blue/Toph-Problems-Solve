#include<stdio.h>
#include<string.h>
int main()
{
    char a[20];
    scanf("%s",&a);

    int len = strlen(a);
    a[0]=a[0]-32;
    for(int i=0; i<len; i++)
    {

        if(a[i]=='s')
        {
            printf("$");
        }
        else if(a[i]=='i')
        {
            printf("!");
        }
        else if(a[i]=='o')
        {
            printf("()");
        }
        else
        {
            printf("%c",a[i]);
        }

    }
    printf(".\n");
}
