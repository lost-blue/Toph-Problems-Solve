#include<bits/stdc++.h>
using namespace std;
int main()
{
    int n;
    cin>>n;
    double sum=0;
    double ave;

    int arr[n];

    for(int i=0;i<n;i++)
    {
        cin>>arr[i];
        sum+=arr[i];
        ave=sum/(i+1);

        if((int)sum%2==0)
        {
            cout<<ave<<endl;
        }
        else
        {
            cout<<fixed<<setprecision(10)<<ave<<endl;
        }

    }

    return 0;
}
