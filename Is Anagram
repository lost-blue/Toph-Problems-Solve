#include <bits/stdc++.h>
using namespace std;
int main() 
{
    string s1,s2;
    cin>>s1>>s2;

    int len1 = s1.length();
    int len2 = s2.length();

    int count=0;

    char c1[5];
    char c2[5];

    for(int i=0;i<len1;i++)
        {
            c1[0]=s1[i];

            for(int j=0;j<len2;j++)
                {
                    c2[0]=s2[j];
                    if(strcmp(c1,c2)==0)
                    {
                        count++;
                    }
                }
        }

    if(count==len1 && count==len2)
    {
        cout<<"Yes"<<endl;
    }
    else
        cout<<"No"<<endl;

}
