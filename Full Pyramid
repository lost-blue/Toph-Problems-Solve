#include<bits/stdc++.h>
using namespace std;
int main()
{
    int x;
    cin>>x;

    for(int i=1;i<=x;i++)
    {
        for(int j=i;j<x;j++)
        {
            cout<<" ";
        }

        for(int k=1;k<=i;k++)
        {
            cout<<"*";
            if(k<i)
            {
                cout<<" ";
            }
        }

        cout<<endl;
    }

    return 0;
}
