#include<bits/stdc++.h>
using namespace std;
int main()
{
    int t,ma; 
    cin>>t;

    int arr[t];

    for(int i=0;i<t;i++)
    {
        cin>>arr[i];
    }

    ma=arr[0];

    for(int i=0;i<t;i++)
    {
        if(arr[i]>ma)
        {
            ma=arr[i];
        }
    }

    cout<<ma<<endl;

    return 0;
}
